# DineDesk Environment Variables

# PostgreSQL Database Connection
# If using docker-compose: postgresql://dinedesk_user:dinedesk_password@localhost:5432/dinedesk_db?schema=public
DATABASE_URL="postgresql://dinedesk_user:dinedesk_password@localhost:5432/dinedesk_db?schema=public"

# Authentication & Session Security (Minimum 32 characters)
AUTH_SECRET="dinedesk-dev-secret-key-replace-in-production-32chars"

# Application Base URL
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Restaurant Operating Timezone
RESTAURANT_TIMEZONE="Asia/Kolkata"

# Payment Provider Configuration: 'test' | 'razorpay' | 'stripe'
PAYMENT_PROVIDER="test"

# Optional Razorpay Test Credentials (for live gateway testing)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_secret_placeholder"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_placeholder"

# Optional Stripe Test Credentials
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"
